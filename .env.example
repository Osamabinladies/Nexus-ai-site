# Copy this file to .env and fill in your keys.

# Used to sign login session cookies (required for accounts/login to work).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_random_64_char_hex_string

# Chatbot (optional — falls back to a built-in rule-based bot if unset)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Stripe test-mode checkout for the Pro plan (optional feature)
# Sign up free at https://dashboard.stripe.com/register, then grab your
# TEST secret key (starts with sk_test_) from https://dashboard.stripe.com/test/apikeys
# Test mode never charges real money — use card 4242 4242 4242 4242, any future date/CVC.
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key_here

# PayPal Sandbox checkout for the Pro plan (optional feature)
# Create a sandbox app at https://developer.paypal.com/dashboard/applications/sandbox
# to get a Client ID and Secret. Test with the sandbox buyer account PayPal
# generates for you under Sandbox > Accounts — never your real PayPal login.
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Contact form -> email (optional — form shows "not configured" without it)
# Uses your own Gmail to send. Requires 2-Step Verification turned on, then
# an App Password from https://myaccount.google.com/apppasswords
# (a normal Gmail password will NOT work here).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_character_app_password
# Where contact-form submissions get sent — defaults to SMTP_USERNAME if unset.
CONTACT_EMAIL_TO=your_gmail_address@gmail.com
